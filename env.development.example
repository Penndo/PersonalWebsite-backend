# 本地开发专用（提交到仓库的是本示例文件）
#
# 用法：复制为 backend/.env.development.local（已被 .gitignore 的 *.local 忽略）
# 仅在 NODE_ENV !== production 时加载，会覆盖 backend/.env 里同名的变量。
#
# 生产环境（PM2 + NODE_ENV=production）只读 backend/.env，不会加载本文件。

DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=Mysql12315
DB_NAME=personal_website
